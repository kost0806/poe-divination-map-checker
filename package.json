{
  "name": "poe-divination-map-checker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PoE 아틀라스 맵별 디비네이션 카드 기대수익 계산기",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "data:build": "tsx scripts/build-data.ts",
    "data:prices": "tsx scripts/refresh-prices.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^5.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
